{
    "name": "laravel-starter/builder",
    "description": "Professional Laravel project generator and scaffolding CLI.",
    "keywords": ["laravel", "starter", "generator", "cli", "scaffold"],
    "homepage": "https://github.com/laravel-starter/builder",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.7.8 || ^5.0.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["laravel-starter"]
}
